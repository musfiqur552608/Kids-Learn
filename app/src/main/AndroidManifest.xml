<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      ============================================================================
      OFFLINE BY CONSTRUCTION
      ============================================================================
      This app declares NO permissions at all. In particular there is no
      <uses-permission android:name="android.permission.INTERNET" />, so the
      process cannot open a socket even if a dependency tried to.

      Consequences that are intentional, not limitations:
        * Letter pronunciation uses the platform's offline TextToSpeech engine.
          If a language pack is not already on the device, Android reports
          LANG_NOT_SUPPORTED and the app falls back to a bundled sound effect.
        * No fonts, sounds or lessons are downloaded. The Noto fonts for Bangla
          and Arabic are bundled in res/font (SIL OFL, see
          assets/licenses/), the sound effects live in res/raw, and the lesson
          catalogs are compiled into the APK as Kotlin constants.
      ============================================================================
    -->

    <!--
      Touch is assumed at runtime, but `android.hardware.touchscreen` is already
      required by default, so declaring it again would only restate the implicit
      rule. Multitouch is declared as *not* required so the app still installs on
      single-touch devices instead of being filtered out of the store.
    -->
    <uses-feature
        android:name="android.hardware.touchscreen.multitouch"
        android:required="false" />

    <!--
      TTS is an enhancement, not a requirement: the app is fully usable (silent,
      with sound-effect feedback) on a device with no TTS engine installed.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".KidsLearnApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KidsLearn"
        tools:targetApi="34">

        <!--
          Portrait lock is a product decision, not an oversight: the letter
          grid, the tracing canvas and the quiz rows are all laid out for a tall
          screen, and a child rotating the phone mid-lesson loses their place.
          Android 16 deprecates fixed orientations in favour of resizable
          windows, hence `DiscouragedApi` in the ignore below.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|fontScale|smallestScreenSize|density"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.KidsLearn"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
